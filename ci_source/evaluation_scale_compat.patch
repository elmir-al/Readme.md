+All rights reserved.
+
+This software was independently designed and developed for the
+Albay Russian Draughts Engine project.
+*/
+#pragma once
+
+#include "albay/evaluation.hpp"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+
+namespace albay {
+
+// The searcher keeps its proven/tuned internal score domain unchanged.
+// All C API score outputs are converted to this stable public domain.
+inline constexpr std::int32_t kPublicEvaluationScale = 10'000;
+inline constexpr std::int32_t kPublicNormalReference = 3'000;
+inline constexpr std::int32_t kPublicMateThreshold = 9'000;
+inline constexpr std::int32_t kPublicMaximumNormalScore = kPublicMateThreshold - 1;
+
+[[nodiscard]] constexpr std::int32_t public_score_from_internal(Score score) noexcept {
+    if (score >= kMateThreshold) {
+        const Score distance = std::clamp<Score>(kMateScore - score, 0, 999);
+        return kPublicEvaluationScale - distance;
+    }
+    if (score <= -kMateThreshold) {
+        const Score distance = std::clamp<Score>(kMateScore + score, 0, 999);
+        return -kPublicEvaluationScale + distance;
+    }
+
+    // Rounded integer conversion from the historic 3000 reference domain to
+    // the public 10000 domain. Values are kept below the reserved mate range.
+    const std::int64_t numerator =
+        static_cast<std::int64_t>(score) * kPublicEvaluationScale;
+    const std::int64_t rounded = numerator >= 0
+        ? numerator + kPublicNormalReference / 2
+        : numerator - kPublicNormalReference / 2;
+    const std::int64_t scaled = rounded / kPublicNormalReference;
+    return static_cast<std::int32_t>(std::clamp<std::int64_t>(
+        scaled, -kPublicMaximumNormalScore, kPublicMaximumNormalScore));
+}
+
+}  // namespace albay
