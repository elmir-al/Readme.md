+    // Shrink the list without reallocating. Capture generation uses this to
+    // remove truncated king landings after a complete continuation has been
+    // discovered for the same jumped piece.
+    void resize(std::size_t new_size) noexcept {
+        if (new_size >= size_) {
+            return;
+        }
+        if constexpr (!std::is_trivially_destructible_v<Move>) {
+            for (std::size_t index = new_size; index < size_; ++index) {
+                std::destroy_at(data() + index);
+            }
+        }
+        size_ = new_size;
+    }
+
     [[nodiscard]] Move& operator[](std::size_t index) noexcept {
         return data()[index];
     }
